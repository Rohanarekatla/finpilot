# Copy to .env (gitignored) and add your key. Every LLM call goes through Mesh API.
MESH_API_KEY=rsk_your_key_here

# Optional overrides
FINPILOT_MODEL_FAST=openai/gpt-4o-mini
FINPILOT_MODEL_SMART=openai/gpt-4o
# Weekly digest job (APScheduler). Off unless set to 1.
FINPILOT_SCHEDULER=1
# FINPILOT_DIGEST_CRON=0 8 * * mon
# Force deterministic fallbacks (no LLM calls)
# FINPILOT_OFFLINE=1
# Seconds per Mesh call before falling back, and retries
# FINPILOT_LLM_TIMEOUT=30
# FINPILOT_LLM_RETRIES=1
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
