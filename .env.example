# Copy to .env (gitignored). Every LLM call goes through Mesh API.
MESH_API_KEY=rsk_your_key_here
# Optional overrides
FINPILOT_MODEL_FAST=openai/gpt-4o-mini
FINPILOT_MODEL_SMART=openai/gpt-4o
# FINPILOT_OFFLINE=1            # force deterministic fallbacks (no LLM)
# FINPILOT_SCHEDULER=1          # weekly digest job (APScheduler)
# FINPILOT_DIGEST_CRON=0 8 * * mon
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
